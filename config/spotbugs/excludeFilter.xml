<!-- Use this file to identify code flagged by SpotBugs that is correct for the situation-->
<FindBugsFilter>
    <!-- assertThrows intentionally ignores the return value of a call that
         is expected to throw. Suppressed for test classes only. -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!-- Constructor injection stores collaborators (Random, Deck) on purpose, so tests can pass mocks. -->
    <Match>
        <Or>
            <Class name="domain.Deck"/>
            <Class name="domain.Game"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>